# --- OpenRouter -------------------------------------------------------------
# Fallback key, used only when the caller sends no Authorization header.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on openrouter.ai/rankings
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- Statewave --------------------------------------------------------------
STATEWAVE_URL=http://localhost:8000
STATEWAVE_API_KEY=
# Default tenant when the caller sends no X-Tenant-ID
STATEWAVE_TENANT_ID=
# Token budget for the injected context bundle
STATEWAVE_CONTEXT_TOKENS=1500
# Kick an async compile after every turn (1/true/yes)
STATEWAVE_COMPILE_AFTER_TURN=
# `source` recorded on written episodes
STATEWAVE_EPISODE_SOURCE=openrouter-proxy
# Caller identity sent on every retrieval. Statewave policy rules match on
# these; tenants with `require_caller_identity` reject calls without them.
STATEWAVE_CALLER_TYPE=openrouter-gateway
STATEWAVE_CALLER_ID=

# --- Proxy ------------------------------------------------------------------
PROXY_TIMEOUT=120
